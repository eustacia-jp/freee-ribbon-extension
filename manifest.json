{
  "manifest_version": 3,
  "name": "Color Ribbon for freee",
  "version": "1.3.0",
  "description": "freeeの画面右上に事業所名と事業所番号を示す色付きリボンを表示し、ログイン中の環境を認識しやすくします。非公式ツールです。",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.freee.co.jp/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.freee.co.jp/*"],
      "exclude_matches": [
        "*://support.freee.co.jp/*",
        "https://brand.freee.co.jp/*",
        "https://a11y-guidelines.freee.co.jp/*"
      ],
      "js": ["js/content.js"],
      "css": ["css/style.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
  },
  "options_page": "options/options.html"
}
